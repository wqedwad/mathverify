.venv/
__pycache__/
*.pyc
*.egg-info/
# Anchored to the repo root on purpose. An unanchored `build/` also matched
# `evalset/build/` — the generators the whole evaluation set is built from — so none of
# them had ever been committed and the set could not be rebuilt from a clone.
/build/
/dist/
.pytest_cache/
.hypothesis/
reports/*.json
# Secrets never enter the repository. `.env` was tracked while the repository was private
# (2026-09-24 .. 2026-11-24) and was removed from the whole history before publication
# (docs/BASVURU.md). API keys live in an untracked `.env` or in the environment.
.env
.env.*
llm_cache/*.tmp
