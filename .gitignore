.venv/
__pycache__/
*.pyc
*.egg-info/
# Anchored to the repo root on purpose. An unanchored `build/` also matched
# `evalset/build/` — the generators the whole evaluation set is built from — so none of
# them had ever been committed and the set could not be rebuilt from a clone.
/build/
/dist/
.pytest_cache/
.hypothesis/
reports/*.json
# `.env` itself is tracked: on 2026-09-24 the user decided that this private repository
# (github.com/wqedwad/asd) carries the API keys so cloud sessions work as-is. Other env files
# stay ignored.
.env.*
llm_cache/*.tmp
